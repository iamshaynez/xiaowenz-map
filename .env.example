# 发布和检查需要的凭据（tools/deploy/publish.mjs、tools/deploy/verify.mjs）。
# 把这个文件复制成 .env 再填：.env 不进 git。每一项从哪里来，见 deploy/README.md。

# ---- R2：数据的桶 ----
# 账户编号：Cloudflare 控制台 R2 Object Storage 页面右侧的 Account ID。
R2_ACCOUNT_ID=
# 桶名：建桶时起的名字。
R2_BUCKET=city
# 一把只对这个桶有读写权限的钥匙：R2 > 管理 R2 API 令牌 > 创建 API 令牌，权限选"对象读和写"、范围指定这一个桶。
# 创建时显示一次的两个值，照抄在这里。不要用账户的全局 API 令牌。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- 以下都只在特殊情况下才要 ----
# 不发到 R2，而是发到自己起的、讲 S3 协议的服务器上（tools/tests/deploy.cjs 自己会这么做）。
# R2_ENDPOINT=http://127.0.0.1:9000

# 这台机器上 `npx wrangler login` 打不开浏览器时，改用令牌：权限是"Workers 脚本：编辑"和区域里"DNS：编辑"
# （自定义域名要建一条 DNS 记录）。账户编号同上。npm run deploy 会把这两个带给 wrangler。
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
